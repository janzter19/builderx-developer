    "onStartupFinished",
    "onUri",
    "onCommand:builderx.sendToCodex"
  ],
  "main": "extension.js",
  "files": ["extension.js", "package.json", "README.md"],
  "contributes": {
    "commands": [
      {
        "command": "builderx.sendToCodex",
        "title": "BuilderX: Send Message to Codex"
      }
    ]
  }
}
