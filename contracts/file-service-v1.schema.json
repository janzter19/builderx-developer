{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://builderx.local/contracts/file-service-v1.schema.json",
  "title": "BuilderX Local File Service v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "operation"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"type": "string", "enum": ["list", "search", "read", "create", "update"]},
    "path": {"type": "string", "maxLength": 1024},
    "query": {"type": "string", "maxLength": 256},
    "contents": {"type": "string", "maxLength": 1048576},
    "limit": {"type": "integer", "minimum": 1, "maximum": 200}
  }
}
